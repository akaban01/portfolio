---
interface Props {
  title: string;
  description: string;
  tags: string[];
  icon?: string;
  featured?: boolean;
  liveUrl?: string;
  codeUrl?: string;
}

const { title, description, tags, icon = '✨', featured = false, liveUrl, codeUrl } = Astro.props;
---

<div class="group relative h-full">
  <div
    class="absolute -inset-0.5 rounded-2xl bg-gradient-to-br from-indigo-500 via-fuchsia-500 to-cyan-400 opacity-0 blur transition duration-500 group-hover:opacity-60"
    aria-hidden="true"
  >
  </div>
  <article class="relative flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-6 transition-transform duration-300 group-hover:-translate-y-1 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="mb-4 flex items-start justify-between">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500/15 to-fuchsia-500/15 text-lg dark:from-indigo-400/15 dark:to-fuchsia-400/15">
        {icon}
      </span>
      {featured && (
        <span class="rounded-full bg-indigo-600/10 px-2.5 py-1 text-[11px] font-semibold text-indigo-600 dark:bg-indigo-400/10 dark:text-indigo-400">
          Featured
        </span>
      )}
    </div>
    <h3 class="mb-2 font-display font-semibold text-neutral-900 dark:text-neutral-100">{title}</h3>
    <p class="mb-4 flex-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{description}</p>
    <div class:list={["flex flex-wrap gap-2", (liveUrl || codeUrl) && "mb-4"]}>
      {tags.map((tag) => (
        <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-600 transition-colors group-hover:bg-indigo-50 dark:bg-neutral-800 dark:text-neutral-400 dark:group-hover:bg-indigo-950/50">
          {tag}
        </span>
      ))}
    </div>
    {(liveUrl || codeUrl) && (
      <div class="flex gap-4 text-sm font-semibold">
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener" class="text-indigo-600 hover:underline dark:text-indigo-400">Live</a>
        )}
        {codeUrl && (
          <a href={codeUrl} target="_blank" rel="noopener" class="text-indigo-600 hover:underline dark:text-indigo-400">Code</a>
        )}
      </div>
    )}
  </article>
</div>
